@page "/alertas"
@rendermode InteractiveServer
@attribute [Authorize(Roles = $"{CaeManager.Infrastructure.Identity.Roles.Administrador},{CaeManager.Infrastructure.Identity.Roles.DireccionCae},{CaeManager.Infrastructure.Identity.Roles.CoordinadorCae},{CaeManager.Infrastructure.Identity.Roles.GestorCae},{CaeManager.Infrastructure.Identity.Roles.Consulta}")]
@using CaeManager.Application.Alertas.Queries.ObtenerAlertas
@using CaeManager.Application.Bandeja.Queries.ObtenerBandejaGestor
@using CaeManager.Domain.Documentos
@using CaeManager.Web.Features.Bandeja.Components
@using CaeManager.Web.Features.Documentos
@using MediatR
@inject IMediator Mediator

<PageTitle>Alertas — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina">
    <h1 class="titulo-pagina">Alertas</h1>

    <SeccionColapsable Titulo="Bandeja priorizada" ExpandidaPorDefecto="true">
        @if (_cargandoBandeja)
        {
            <EstadoCargando Filas="3" />
        }
        else if (_itemsBandeja.Count == 0)
        {
            <p class="texto-vacio-seccion">Nada pendiente ahora mismo.</p>
        }
        else
        {
            <div class="lista-bandeja dashboard-lista-unificada">
                @foreach (var item in _itemsBandeja)
                {
                    <PanelResolverItem Item="item" />
                }
            </div>
            <a href="/bandeja" class="enlace-nombre-fila">Ver todo en Mi trabajo →</a>
        }
    </SeccionColapsable>

    <div class="barra-filtros">
        <CampoSelect Etiqueta="Estado" Valor="@_estadoFiltro" ValorChanged="CambiarEstadoFiltroAsync">
            <option value="">Todos</option>
            <option value="@nameof(EstadoDocumento.Faltante)">Falta</option>
            <option value="@nameof(EstadoDocumento.Vencido)">Vencido</option>
            <option value="@nameof(EstadoDocumento.Urgente)">Urgente</option>
            <option value="@nameof(EstadoDocumento.Proximo)">Próximo</option>
        </CampoSelect>
    </div>

    @if (_errorCarga)
    {
        <EstadoVacio Titulo="No pudimos cargar las alertas" Descripcion="Intenta nuevamente en unos segundos.">
            <Accion>
                <Boton OnClick="CargarAsync">Reintentar</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (_cargando)
    {
        <EstadoCargando Filas="6" />
    }
    else if (AlertasFiltradas.Count == 0)
    {
        <EstadoVacio Titulo="No hay alertas activas" Descripcion="Todos los documentos están vigentes o fuera del umbral de aviso." />
    }
    else
    {
        <table class="tabla-datos">
            <thead>
                <tr>
                    <th>Estado</th>
                    <th>Trabajador</th>
                    <th>Tipo de documento</th>
                    <th>Centro</th>
                    <th>Vencimiento</th>
                    <th>Archivo</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var alerta in AlertasDePagina)
                {
                    <tr>
                        <td><Badge Tono="EstadoDocumentoUi.Tono(alerta.Estado)">@EstadoDocumentoUi.Texto(alerta.Estado)</Badge></td>
                        <td>@alerta.TrabajadorNombre</td>
                        <td>@alerta.TipoDocumentoNombre</td>
                        <td>@(alerta.CentroNombre ?? "—")</td>
                        <td>@(alerta.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td>
                            @if (alerta.DocumentoId is not null && alerta.ArchivoUrl is not null)
                            {
                                <a href="/documentos/@alerta.DocumentoId/archivo" target="_blank">Ver PDF</a>
                            }
                            else
                            {
                                <span class="detalle-tecnico">Sin adjunto</span>
                            }
                        </td>
                        <td>
                            <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="() => GestionarAlerta(alerta)">
                                @(alerta.DocumentoId is not null ? "Gestionar" : "Subir documento")
                            </Boton>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <PaginadorSimple PaginaActual="_pagina" TotalPaginas="TotalPaginas" TotalElementos="AlertasFiltradas.Count"
                          Etiqueta="alerta(s)" PaginaActualChanged="IrAPaginaAsync"
                          TamanoPagina="_tamanoPagina" TamanoPaginaChanged="CambiarTamanoPaginaAsync" />
    }
</div>
