@*
    Una tarjeta = un GRUPO de la Bandeja agrupada "por situación" (rediseño de
    Inicio, hallazgo P-03 de la auditoría de producto 2026-08-16): en vez de
    una pared de PanelResolverItem sueltos, una cabecera plegable por Cliente/
    Empresa con los recuentos por severidad, y sus items dentro al expandir.
    Colapsado por defecto — mismo criterio que SeccionColapsable, pero esta no
    la reutiliza directamente porque necesita renderizar badges de recuento
    junto al título, no solo un Encabezado libre.

    Cada badge de recuento es una VentanaContexto (08 § 6, DDL-032/033): "12
    vencidos" es un número que exige poder desglosarse sin tener que expandir
    todo el grupo para leer sus 12 items uno a uno — mismo principio que ya
    aplica AcordeonAsignacionesCentro sobre los recuentos por trabajador.
*@
@using CaeManager.Application.Bandeja.Queries.ObtenerBandejaAgrupada
@using CaeManager.Application.Bandeja.Queries.ObtenerBandejaGestor
@using CaeManager.Web.Components.DesignSystem
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager
@inject CaeManager.Web.Components.Workspace.ContextWorkspaceService WorkspaceService

<div class="grupo-cola">
    <button type="button"
            class="grupo-cola-cabecera"
            aria-expanded="@(_expandida ? "true" : "false")"
            aria-controls="@_panelId"
            @onclick="Alternar">
        <span class="@("grupo-cola-chevron" + (_expandida ? " grupo-cola-chevron-abierta" : ""))">
            <Icono Nombre="chevron" Tamano="TamanoIcono.Pequeno" />
        </span>
        <span class="grupo-cola-info">
            <span class="grupo-cola-titulo">@Grupo.Titulo</span>
            <span class="grupo-cola-resumen">@Resumen</span>
        </span>
        <span class="grupo-cola-badges">
            @if (Grupo.BloqueaAcceso)
            {
                <Badge Tono="TonoBadge.Peligro">Bloquea acceso</Badge>
            }
            @foreach (var recuento in Recuentos)
            {
                <VentanaContexto Etiqueta="@DescribirRecuento(recuento)" Titulo="@($"{recuento.Cantidad} {recuento.Etiqueta}")">
                    <Disparador>
                        <Badge Tono="recuento.Tono">@recuento.Cantidad @recuento.Etiqueta</Badge>
                    </Disparador>
                    <Detalle>
                        @foreach (var item in recuento.Items)
                        {
                            <span class="ventana-linea">@item.Titulo — @item.Subtitulo</span>
                        }
                    </Detalle>
                </VentanaContexto>
            }
        </span>
    </button>
    @if (_expandida)
    {
        <div class="grupo-cola-contenido" id="@_panelId">
            @foreach (var empresa in GruposAnidados)
            {
                @if (AgruparPorEmpresa && empresa.EmpresaNombre is not null)
                {
                    <div class="grupo-cola-subcabecera grupo-cola-subcabecera-empresa">@empresa.EmpresaNombre</div>
                }
                @foreach (var trabajador in empresa.Trabajadores.Take(MaximoTrabajadoresVisibles))
                {
                    @if (trabajador.TrabajadorNombre is not null)
                    {
                        <div class="grupo-cola-subcabecera grupo-cola-subcabecera-trabajador">@trabajador.TrabajadorNombre</div>
                    }
                    @foreach (var item in trabajador.Items)
                    {
                        @if (Compacto)
                        {
                            <div class="grupo-cola-fila-compacta">
                                <span class="grupo-cola-fila-compacta-titulo">@TituloBajoTrabajador(item)</span>
                                <span class="grupo-cola-fila-compacta-fecha">@(item.Fecha?.ToString("dd/MM") is { } f ? $"Vence {f}" : "—")</span>
                                <Badge Tono="TipoItemBandejaUi.Tono(item)">@TipoItemBandejaUi.Texto(item)</Badge>
                                <a href="#" class="grupo-cola-fila-compacta-accion" @onclick="() => AbrirAsync(item)" @onclick:preventDefault>@TipoItemBandejaUi.TextoAccion(item)</a>
                            </div>
                        }
                        else
                        {
                            <PanelResolverItem @key="item.Id" Item="@(item with { Titulo = TituloBajoTrabajador(item) })" Enfocado="@(item.Id == IdEnfocado)" />
                        }
                    }
                }
                @if (empresa.Trabajadores.Count > MaximoTrabajadoresVisibles)
                {
                    <div class="grupo-cola-truncado">
                        @if (CentroUnicoDe(OcultosDe(empresa)) is { } centroId)
                        {
                            <a class="enlace-ver-todas" href="@($"/centros/{centroId}")">Ver @OcultosDe(empresa).Count trabajador@(OcultosDe(empresa).Count == 1 ? "" : "es") más en este Centro →</a>
                        }
                        else
                        {
                            <a class="enlace-ver-todas" href="/bandeja">Ver @OcultosDe(empresa).Count trabajador@(OcultosDe(empresa).Count == 1 ? "" : "es") más en Mi trabajo →</a>
                        }
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    /// <summary>
    /// Un grupo real (cartera grande) puede traer decenas de trabajadores con
    /// varios documentos cada uno — sin tope, la fila expandida se vuelve una
    /// pared interminable. Trunca por TRABAJADOR (no por item suelto): la
    /// unidad con la que el gestor razona aquí es "¿a cuántas personas tengo
    /// que atender?", no "¿cuántas filas hay?".
    /// </summary>
    private const int MaximoTrabajadoresVisibles = 5;

    private readonly string _panelId = $"grupo-cola-{Guid.NewGuid():N}";
    private bool _expandida;

    [Parameter, EditorRequired] public GrupoColaDto Grupo { get; set; } = default!;

    /// <summary>Colapsado por defecto salvo que el llamador ya sepa que este es el primer grupo (ver Inicio.razor: el primero que bloquea acceso se abre solo).</summary>
    [Parameter] public bool ExpandidaPorDefecto { get; set; }

    /// <summary>
    /// Fila simple (título · fecha · badge · enlace de texto) en vez del
    /// PanelResolverItem completo — mockup Inicio TALVEG, donde el grupo es
    /// un resumen, no el sitio principal de operar. Mi trabajo (la cola
    /// completa) usará el valor por defecto (false) cuando le toque su
    /// propio rediseño: ahí sí hace falta la acción rica de cada fila.
    /// </summary>
    [Parameter] public bool Compacto { get; set; }

    /// <summary>
    /// Segundo nivel de agrupación dentro del grupo (Cliente/Empresa titular)
    /// — Empresa contratista → Trabajador en vocabulario Consultora (varias
    /// Empresas trabajan para el mismo Cliente), o directo a Trabajador en
    /// ClienteDirecto/"empresa final" (una única Empresa, la del propio
    /// tenant — mostrar ese nivel sería redundante). Ver
    /// PerfilVocabularioTenant y ObtenerPerfilVocabularioActualQuery: el
    /// llamador (Inicio) resuelve el perfil una vez y lo pasa aquí en
    /// vez de que cada GrupoCola vuelva a preguntarlo.
    /// </summary>
    [Parameter] public bool AgruparPorEmpresa { get; set; }

    /// <summary>Id del item con foco de teclado (j/k, ver Bandeja.razor.cs) — solo relevante fuera de Compacto, donde cada item es un PanelResolverItem completo.</summary>
    [Parameter] public string? IdEnfocado { get; set; }

    protected override void OnInitialized() => _expandida = ExpandidaPorDefecto;

    private void Alternar() => _expandida = !_expandida;

    private Task AbrirAsync(ItemBandejaDto item) => AccionesBandeja.AbrirAsync(item, NavigationManager, WorkspaceService);

    /// <summary>
    /// Algunos orígenes (RequisitoPendiente: ver ObtenerBandejaGestorQuery.Fusionar)
    /// componen el Titulo con "— NombreTrabajador" porque en otros consumidores
    /// (PanelResolverItem en /bandeja, sin subcabecera propia) es la única
    /// forma de decir de quién es la fila. Aquí ya lo dice la subcabecera de
    /// trabajador — repetirlo leería como un error de copia, no como énfasis.
    /// </summary>
    private static string TituloBajoTrabajador(ItemBandejaDto item)
    {
        if (item.TrabajadorNombre is not { Length: > 0 } nombre) return item.Titulo;

        var sufijo = $" — {nombre}";
        return item.Titulo.EndsWith(sufijo, StringComparison.Ordinal)
            ? item.Titulo[..^sufijo.Length]
            : item.Titulo;
    }

    private sealed record GrupoTrabajadorItems(string? TrabajadorNombre, IReadOnlyList<ItemBandejaDto> Items);
    private sealed record GrupoEmpresaItems(string? EmpresaNombre, IReadOnlyList<GrupoTrabajadorItems> Trabajadores);

    /// <summary>
    /// Un GrupoColaDto agrupa por Cliente o Empresa, NUNCA por Centro (ver
    /// ObtenerBandejaAgrupadaQueryHandler.ClaveGrupo) — los trabajadores
    /// ocultos por el truncado pueden pertenecer a Centros distintos, así que
    /// el enlace "ver más" solo puede apuntar a un Centro concreto cuando
    /// TODOS comparten el mismo (decisión de producto 2026-08-17): si no,
    /// enlazar a un Centro cualquiera sería llevar al gestor al sitio
    /// equivocado para parte de lo que dejó fuera.
    /// </summary>
    private static IReadOnlyList<GrupoTrabajadorItems> OcultosDe(GrupoEmpresaItems empresa) =>
        [.. empresa.Trabajadores.Skip(MaximoTrabajadoresVisibles)];

    private static Guid? CentroUnicoDe(IReadOnlyList<GrupoTrabajadorItems> ocultos)
    {
        var centros = ocultos.SelectMany(t => t.Items)
            .Select(i => i.CentroId)
            .Where(id => id is not null)
            .Select(id => id!.Value)
            .Distinct()
            .ToList();
        return centros.Count == 1 ? centros[0] : null;
    }

    /// <summary>
    /// Items sin Trabajador identificable (VisitaUrgente, SugerenciaVisitaUrgente,
    /// DeteccionPendiente — ver ObtenerBandejaGestorQuery.Fusionar) no tienen
    /// nada real que encabezar: se listan sin subcabecera de trabajador en vez
    /// de inventar un cubo "Otros" que no aporta información.
    /// </summary>
    private static IReadOnlyList<GrupoTrabajadorItems> AgruparPorTrabajador(IEnumerable<ItemBandejaDto> items) =>
        items
            .GroupBy(i => i.TrabajadorId)
            .Select(g => new GrupoTrabajadorItems(g.First().TrabajadorNombre, (IReadOnlyList<ItemBandejaDto>)g.ToList()))
            .OrderBy(g => g.TrabajadorNombre is null ? 1 : 0)
            .ThenBy(g => g.TrabajadorNombre)
            .ToList();

    private IReadOnlyList<GrupoEmpresaItems> GruposAnidados
    {
        get
        {
            if (!AgruparPorEmpresa)
                return [new GrupoEmpresaItems(null, AgruparPorTrabajador(Grupo.Items))];

            return Grupo.Items
                .GroupBy(i => i.EmpresaId)
                .Select(g => new GrupoEmpresaItems(g.First().EmpresaNombre, AgruparPorTrabajador(g)))
                .OrderBy(g => g.EmpresaNombre is null ? 1 : 0)
                .ThenBy(g => g.EmpresaNombre)
                .ToList();
        }
    }

    private string Resumen
    {
        get
        {
            var trabajadores = Grupo.Items.Select(i => i.TrabajadorId).Where(id => id is not null).Distinct().Count();
            var pendientes = Grupo.Items.Count == 1 ? "1 pendiente" : $"{Grupo.Items.Count} pendientes";
            return trabajadores > 0
                ? $"{pendientes} · {(trabajadores == 1 ? "1 trabajador" : $"{trabajadores} trabajadores")}"
                : pendientes;
        }
    }

    /// <summary>Un badge de recuento por cada tono de severidad presente en el grupo — reutiliza TipoItemBandejaUi, mismo vocabulario que cada PanelResolverItem individual. Conserva los items del tono para que la VentanaContexto pueda desglosarlos (DDL-033).</summary>
    private IEnumerable<(TonoBadge Tono, string Etiqueta, int Cantidad, IReadOnlyList<ItemBandejaDto> Items)> Recuentos =>
        Grupo.Items
            .GroupBy(i => TipoItemBandejaUi.Tono(i))
            .Select(g => (Tono: g.Key, Etiqueta: EtiquetaTono(g.Key), Cantidad: g.Count(), Items: (IReadOnlyList<ItemBandejaDto>)g.ToList()))
            .OrderByDescending(r => r.Tono == TonoBadge.Peligro)
            .ThenByDescending(r => r.Cantidad);

    private static string EtiquetaTono(TonoBadge tono) => tono switch
    {
        TonoBadge.Peligro => "vencidos",
        TonoBadge.Advertencia => "próximos",
        _ => "pendientes"
    };

    /// <summary>Nombre accesible de la ventana de contexto — lo único que oye un lector de pantalla, así que dice lo mismo que el Detalle en una frase (mismo criterio que DescribirRecuentoTrabajador en AcordeonAsignacionesCentro).</summary>
    private static string DescribirRecuento((TonoBadge Tono, string Etiqueta, int Cantidad, IReadOnlyList<ItemBandejaDto> Items) recuento) =>
        recuento.Cantidad == 1
            ? $"1 {recuento.Etiqueta.TrimEnd('s')}: {recuento.Items[0].Titulo}"
            : $"{recuento.Cantidad} {recuento.Etiqueta}: {string.Join(", ", recuento.Items.Select(i => i.Titulo))}";
}
