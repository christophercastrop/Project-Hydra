@*
    Contenido del acordeón "Asignaciones" de una fila de /centros (Centro 360,
    PLAN-EJECUCION-UX.md § 0.1/0.2). Autocontenido: solo se instancia cuando
    el usuario expande la fila (SeccionColapsable no renderiza su
    ChildContent hasta entonces), así que la Query de este componente ya es
    en sí misma la carga perezosa — no hace falta ningún guard adicional.

    Sustituye a la página /asignaciones para este Centro: mismo drawer de
    alta N×M (matriz + preflight) que tenía esa página, ahora con el Centro
    de esta fila pre-marcado, más la baja en lote (DarDeBajaAsignacionesCommand,
    antes sin ningún caller) y el tercer nivel de documentación requerida por
    trabajador.
*@
@using CaeManager.Application.Alertas
@using CaeManager.Application.Asignaciones.Commands.CrearAsignaciones
@using CaeManager.Application.Asignaciones.Commands.DarDeBajaAsignaciones
@using CaeManager.Application.Asignaciones.Queries.ObtenerAsignacionesDocumentacionPorCentro
@using CaeManager.Application.Asignaciones.Queries.ObtenerDocumentosFaltantesParaAsignacion
@using CaeManager.Application.Centros.Queries.ObtenerCentrosParaSelector
@using CaeManager.Application.Trabajadores.Queries.ObtenerTrabajadoresParaSelector
@using CaeManager.Domain.Documentos
@using CaeManager.Web.Features.Documentos
@using CaeManager.Web.Features.Documentos.Components
@using FluentValidation
@using MediatR
@inject IMediator Mediator
@inject ToastService ToastService

@if (_errorCarga)
{
    <EstadoVacio Titulo="No pudimos cargar las asignaciones" Descripcion="Intenta nuevamente en unos segundos.">
        <Accion>
            <Boton OnClick="CargarAsync">Reintentar</Boton>
        </Accion>
    </EstadoVacio>
}
else if (_cargando)
{
    <EstadoCargando Filas="3" />
}
else
{
    <div class="acordeon-asignaciones-cabecera">
        <Boton Tamano="TamanoBoton.Pequeno" OnClick="() => _drawerAsignacion.AbrirAsync(new[] { CentroId })">+ Asignar trabajador</Boton>
        <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" Deshabilitado="_seleccionados.Count == 0" OnClick="AbrirConfirmarBajaLoteAsync">
            Dar de baja seleccionados
        </Boton>
    </div>

    @*
        Ámbito EMPRESA (OD-13, blueprint § 3.3). Aparece solo cuando la empresa
        del centro tiene documentación con incidencia, y lista únicamente lo que
        hay que resolver — el resto se consulta desde "Detalles" de la empresa.

        La nota no es decorativa: sin ella, ver una lista corta se leería como
        "la empresa casi no tiene documentación", cuando lo que dice es "esto es
        lo que falla". Un vacío nunca se presenta como éxito (04 § 6).
    *@
    @if (IncidenciasEmpresa.Count > 0)
    {
        <div class="separador-ambito">Empresa</div>
        <div class="fila-sujeto-ambito">
            <span class="sujeto-ambito-identidad">
                <span class="sujeto-ambito-nombre">@EmpresaNombre <span class="etiqueta-ambito">Empresa</span></span>
                <span class="sujeto-ambito-nota">Solo se listan las incidencias; el resto de su documentación está en Detalles.</span>
            </span>
            <span class="sujeto-ambito-indicadores">
                <VentanaContexto Etiqueta="@($"{IncidenciasEmpresa.Count} {(IncidenciasEmpresa.Count == 1 ? "documento de empresa con incidencia" : "documentos de empresa con incidencia")}")"
                                 Titulo="Documentación de la empresa">
                    <Disparador>
                        <Badge Tono="TonoBadge.Peligro" Tamano="TamanoBadge.Pequeno" class="badge-solo-recuento">
                            @IncidenciasEmpresa.Count
                        </Badge>
                    </Disparador>
                    <Detalle>
                        @foreach (var incidencia in IncidenciasEmpresa)
                        {
                            <span class="ventana-linea">@incidencia.Descripcion</span>
                        }
                    </Detalle>
                </VentanaContexto>
            </span>
            <span class="sujeto-ambito-accion">
                <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" class="accion-fila-enlace" OnClick="AbrirDetalleEmpresa">
                    Detalles
                </Boton>
            </span>
        </div>
        @*
            Tabla de documentos del bloque Empresa (contrato de fidelidad
            2026-08-09 § 1.5): mismas columnas fijas Documento · Estado ·
            Vigencia · Acción que la tabla de Trabajador, misma rejilla
            (tabla-documentos-requeridos). Sin toggle de expandir: a
            diferencia de Trabajador (muchas filas, una tabla por fila), aquí
            solo hay un sujeto y el bloque entero ya solo aparece cuando hay
            incidencias que resolver.
        *@
        <div class="tabla-documentos-requeridos" role="table" aria-label="@($"Documentación con incidencia de {EmpresaNombre}")">
            <div class="documentos-requeridos-cabecera" role="row">
                <span role="columnheader">Documento</span>
                <span role="columnheader">Estado</span>
                <span role="columnheader">Vigencia</span>
                <span role="columnheader" class="columna-accion">Acción</span>
            </div>
            @foreach (var incidencia in IncidenciasEmpresa)
            {
                <div class="fila-documento-requerido" role="row" @key="incidencia.TipoDocumentoId">
                    <span class="celda-documento-nombre" role="cell">
                        <button type="button" class="enlace-nombre-fila" @onclick="() => GestionarEmpresaAsync(incidencia)">
                            @incidencia.Descripcion
                        </button>
                    </span>
                    @* Estado siempre presente: IncidenciasEmpresa solo contiene causas ya calculadas con un valor real. *@
                    <span role="cell">
                        <Badge Tono="EstadoDocumentoUi.Tono(incidencia.Estado!.Value)" Tamano="TamanoBadge.Pequeno">
                            @EstadoDocumentoUi.Texto(incidencia.Estado!.Value)
                        </Badge>
                    </span>
                    <span role="cell">
                        <TextoFechaCopiable Fecha="incidencia.FechaVencimiento" Class="celda-documento-vigencia">
                            @TextoVigenciaEmpresa(incidencia)
                        </TextoFechaCopiable>
                    </span>
                    <span class="columna-accion" role="cell">
                        <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" class="accion-fila-enlace"
                               OnClick="() => GestionarEmpresaAsync(incidencia)">
                            Gestionar
                        </Boton>
                    </span>
                </div>
            }
        </div>
        <div class="separador-ambito">Trabajadores</div>
    }

    @if (_trabajadoresVisitaSinAsignacion.Count > 0)
    {
        <div class="alerta-info" role="status">
            <p>La próxima visita a este centro incluye a estos trabajadores sin asignación activa aquí:</p>
            @foreach (var trabajador in _trabajadoresVisitaSinAsignacion)
            {
                <div class="fila-documento-requerido" @key="trabajador.TrabajadorId">
                    <span class="fila-documento-requerido-nombre">@trabajador.TrabajadorNombre</span>
                    <Boton Tamano="TamanoBoton.Pequeno" Cargando="_asignandoDesdeVisita.Contains(trabajador.TrabajadorId)"
                           OnClick="() => AsignarDesdeVisitaAsync(trabajador)">
                        Asignar
                    </Boton>
                </div>
            }
        </div>
    }

    @if (_trabajadores.Count == 0)
    {
        <EstadoVacio Titulo="Sin trabajadores asignados" Descripcion="Ningún trabajador tiene una asignación activa en este centro." />
    }
    else if (TrabajadoresAMostrar.Count == 0)
    {
        <EstadoVacio Titulo="Todos al día" Descripcion="@($"Los {_trabajadores.Count} trabajadores de este centro tienen su documentación completa.")">
            <Accion>
                <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" OnClick="VerCentroCompleto">
                    Ver los @_trabajadores.Count en Centro 360
                </Boton>
            </Accion>
        </EstadoVacio>
    }
    else
    {
        @if (TrabajadoresAMostrar.Count > 1)
        {
            <div class="acordeon-asignaciones-busqueda">
                <CampoTexto Placeholder="Buscar trabajador…" Valor="@_busquedaTrabajador" ValorChanged="v => _busquedaTrabajador = v" />
            </div>
        }
        @if (TrabajadoresFiltrados.Count == 0)
        {
            <EstadoVacio Titulo="Sin coincidencias" Descripcion="@($"Ningún trabajador coincide con «{_busquedaTrabajador}».")">
                <Accion>
                    <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" OnClick="() => _busquedaTrabajador = string.Empty">
                        Limpiar búsqueda
                    </Boton>
                </Accion>
            </EstadoVacio>
        }
        else
        {
        <div class="lista-trabajadores-acordeon">
            @foreach (var trabajador in TrabajadoresFiltrados)
            {
                var expandido = _expandidosTrabajador.Contains(trabajador.AsignacionId);
                var vencidos = DocumentosVencidos(trabajador);
                var proximos = DocumentosProximos(trabajador);
                var urgentes = DocumentosUrgentes(trabajador);
                <div class="fila-trabajador-acordeon" @key="trabajador.AsignacionId">
                    @if (SeleccionMultiple)
                    {
                        <input type="checkbox" checked="@_seleccionados.Contains(trabajador.AsignacionId)"
                               @onchange="e => AlternarSeleccion(trabajador.AsignacionId, (bool)e.Value!)" />
                    }
                    <div class="fila-trabajador-acordeon-cuerpo">
                        @*
                            Fila de Trabajador (contrato de fidelidad 2026-08-09 § 1.4):
                            mismo lenguaje que la fila de Centro — grid de 5 columnas
                            fijas, sin anillo de cumplimiento (el lámina solo lo pone a
                            nivel de Centro) y con el mismo grid de 3 ranuras de badges
                            que usa el Centro. Composición nueva, NO adaptada de
                            SeccionColapsable (prohibida como base visual, § 1.2) — el
                            expand/collapse reutiliza solo el mecanismo, con el chevron
                            propio ya usado en la fila de Centro.
                        *@
                        <div class="fila-trabajador-rejilla">
                            <button type="button" class="@("boton-expandir-fila" + (expandido ? " boton-expandir-fila-abierta" : ""))"
                                    aria-expanded="@(expandido ? "true" : "false")"
                                    aria-label="@($"Documentos exigidos a {trabajador.TrabajadorNombre}")"
                                    @onclick="() => AlternarExpansionTrabajador(trabajador.AsignacionId)">
                                <Icono Nombre="chevron" Tamano="TamanoIcono.Pequeno" />
                            </button>
                            <button type="button" class="enlace-nombre-fila fila-trabajador-nombre" @onclick="() => AbrirDetalleTrabajador(trabajador)">
                                @trabajador.TrabajadorNombre
                            </button>
                            <span class="fila-trabajador-fraccion">
                                @(trabajador.Documentos.Count > 0 ? $"{DocumentosAlDia(trabajador)}/{trabajador.Documentos.Count}" : "—")
                            </span>
                            <span class="tarjeta-fila-acordeon-indicadores">
                                <span class="ranura-recuento">
                                    @if (vencidos.Count > 0)
                                    {
                                        <VentanaContexto Etiqueta="@DescribirRecuentoTrabajador(vencidos, "vencido")"
                                                         Titulo="@($"{vencidos.Count} {(vencidos.Count == 1 ? "documento vencido" : "documentos vencidos")}")">
                                            <Disparador>
                                                <Badge Tono="TonoBadge.Peligro" Tamano="TamanoBadge.Pequeno" class="badge-solo-recuento">
                                                    @vencidos.Count
                                                </Badge>
                                            </Disparador>
                                            <Detalle>
                                                @foreach (var documento in vencidos)
                                                {
                                                    <span class="ventana-linea">@DescribirDocumentoIncidencia(documento)</span>
                                                }
                                            </Detalle>
                                        </VentanaContexto>
                                    }
                                </span>
                                <span class="ranura-recuento">
                                    @if (proximos.Count > 0)
                                    {
                                        <VentanaContexto Etiqueta="@DescribirRecuentoTrabajador(proximos, "próximo a vencer")"
                                                         Titulo="@($"{proximos.Count} {(proximos.Count == 1 ? "documento próximo a vencer" : "documentos próximos a vencer")}")">
                                            <Disparador>
                                                <Badge Tono="TonoBadge.Advertencia" Tamano="TamanoBadge.Pequeno" class="badge-solo-recuento">
                                                    @proximos.Count
                                                </Badge>
                                            </Disparador>
                                            <Detalle>
                                                @foreach (var documento in proximos)
                                                {
                                                    <span class="ventana-linea">@DescribirDocumentoIncidencia(documento)</span>
                                                }
                                            </Detalle>
                                        </VentanaContexto>
                                    }
                                </span>
                                <span class="ranura-recuento ranura-recuento-final">
                                    @if (urgentes.Count > 0)
                                    {
                                        <VentanaContexto Etiqueta="@DescribirRecuentoTrabajador(urgentes, "urgente")"
                                                         Titulo="@($"{urgentes.Count} {(urgentes.Count == 1 ? "documento urgente" : "documentos urgentes")}")">
                                            <Disparador>
                                                <Badge Tono="TonoBadge.Peligro" Tamano="TamanoBadge.Pequeno" class="badge-solo-recuento">
                                                    @urgentes.Count
                                                </Badge>
                                            </Disparador>
                                            <Detalle>
                                                @foreach (var documento in urgentes)
                                                {
                                                    <span class="ventana-linea">@DescribirDocumentoIncidencia(documento)</span>
                                                }
                                            </Detalle>
                                        </VentanaContexto>
                                    }
                                </span>
                            </span>
                            <span class="fila-trabajador-accion">
                                <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno"
                                       class="@("accion-fila-enlace" + (trabajador.PeorEstado == EstadoDocumento.Vigente ? " accion-atenuada" : null))"
                                       OnClick="() => AbrirDetalleTrabajador(trabajador)">
                                    Detalles
                                </Boton>
                            </span>
                        </div>
                        @if (expandido)
                        {
                            @if (trabajador.Documentos.Count == 0)
                            {
                                <p class="texto-vacio-seccion">Este centro no exige documentación específica a este trabajador.</p>
                            }
                            else
                            {
                                @*
                                    Tercer nivel, variante A (OD-12 cerrada, contrato § 1.5,
                                    blueprint § 3.4, DDL-034): columnas FIJAS
                                    Documento · Estado · Vigencia · Acción.

                                    La rejilla vive en el contenedor y no en cada fila: es lo
                                    que hace que las cuatro columnas caigan en la misma
                                    vertical aunque una fila no tenga fecha de vigencia.
                                *@
                                <div class="tabla-documentos-requeridos" role="table"
                                     aria-label="@($"Documentación exigida a {trabajador.TrabajadorNombre}")">
                                    <div class="documentos-requeridos-cabecera" role="row">
                                        <span role="columnheader">Documento</span>
                                        <span role="columnheader">Estado</span>
                                        <span role="columnheader">Vigencia</span>
                                        <span role="columnheader" class="columna-accion">Acción</span>
                                    </div>
                                    @foreach (var documento in trabajador.Documentos)
                                    {
                                        <div class="fila-documento-requerido" role="row" @key="documento.TipoDocumentoId">
                                            <span class="celda-documento-nombre" role="cell">
                                                <button type="button" class="enlace-nombre-fila" @onclick="() => GestionarAsync(trabajador.TrabajadorId, documento)">
                                                    @documento.TipoDocumentoNombre
                                                </button>
                                            </span>
                                            <span role="cell">
                                                @if (documento.DocumentoId is null)
                                                {
                                                    <VentanaContexto Etiqueta="Pendiente de subir: el centro lo exige y no hay ningún documento todavía"
                                                                     Titulo="Pendiente de subir">
                                                        <Disparador>
                                                            <Badge Tono="TonoBadge.Neutro" Tamano="TamanoBadge.Pequeno">Pendiente de Subir</Badge>
                                                        </Disparador>
                                                        <Detalle>
                                                            Este centro exige el documento y todavía no hay ninguno subido.
                                                        </Detalle>
                                                    </VentanaContexto>
                                                }
                                                else if (documento.CaducaEnVentanaVisita)
                                                {
                                                    @*
                                                        "Riesgo en visita" es MODIFICADOR sobre Vigente, no un
                                                        cuarto estado (DDL-039, DDL-052): el badge conserva su
                                                        tono y la ventana explica la fecha de referencia.
                                                    *@
                                                    <VentanaContexto Etiqueta="Riesgo en visita: vigente hoy, caduca antes de que termine la próxima visita"
                                                                     Titulo="Vigente hoy, caduca en la visita">
                                                        <Disparador>
                                                            <Badge Tono="EstadoDocumentoUi.Tono(documento.Estado)"
                                                                   Tamano="TamanoBadge.Pequeno"
                                                                   class="badge-riesgo-ventana-visita">
                                                                @EstadoDocumentoUi.Texto(documento.Estado)
                                                            </Badge>
                                                        </Disparador>
                                                        <Detalle>
                                                            @if (documento.FechaVencimiento is { } vence)
                                                            {
                                                                <span class="ventana-linea">Válido hasta el @vence.ToString("dd/MM/yyyy").</span>
                                                            }
                                                            <span class="ventana-linea">
                                                                La próxima visita termina después de esa fecha, así que
                                                                dejaría de estar al día durante ella.
                                                            </span>
                                                        </Detalle>
                                                    </VentanaContexto>
                                                }
                                                else
                                                {
                                                    <Badge Tono="EstadoDocumentoUi.Tono(documento.Estado)" Tamano="TamanoBadge.Pequeno">
                                                        @EstadoDocumentoUi.Texto(documento.Estado)
                                                    </Badge>
                                                }
                                            </span>
                                            <span role="cell">
                                                <TextoFechaCopiable Fecha="documento.FechaVencimiento" Class="celda-documento-vigencia">
                                                    @TextoVigencia(documento)
                                                </TextoFechaCopiable>
                                            </span>
                                            <span class="columna-accion" role="cell">
                                                @*
                                                    La acción existe SIEMPRE y se atenúa cuando el documento no
                                                    la necesita (blueprint § 3.4, 04 § 2.5) — no desaparece: un
                                                    documento al día también puede querer sustituirse.
                                                *@
                                                <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno"
                                                       class="@("accion-fila-enlace" + (RequiereIntervencion(documento) ? null : " accion-atenuada"))"
                                                       OnClick="() => GestionarAsync(trabajador.TrabajadorId, documento)">
                                                    Gestionar
                                                </Boton>
                                            </span>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </div>
        }
        @if (TrabajadoresOcultosAlDia > 0)
        {
            <div class="nota-trabajadores-ocultos">
                <span>@TrabajadoresOcultosAlDia @(TrabajadoresOcultosAlDia == 1 ? "trabajador al día no se muestra aquí" : "trabajadores al día no se muestran aquí")</span>
                <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" class="accion-fila-enlace" OnClick="VerCentroCompleto">
                    Ver Centro 360 →
                </Boton>
            </div>
        }
    }
}

<Modal Visible="_confirmarBajaLoteVisible" VisibleChanged="v => _confirmarBajaLoteVisible = v" Titulo="@($"Dar de baja a {_seleccionados.Count} trabajador(es)")">
    <ChildContent>
        <p>Dejarán de estar activos en @CentroNombre a partir de la fecha indicada. El historial de la asignación se conserva.</p>
        <CampoTexto Etiqueta="Fecha de baja" Type="date" Valor="@_fechaBajaLote" ValorChanged="v => _fechaBajaLote = v" />
    </ChildContent>
    <Pie>
        <Boton Variante="VarianteBoton.Secundario" Deshabilitado="_procesandoBajaLote" OnClick="() => _confirmarBajaLoteVisible = false">
            Cancelar
        </Boton>
        <Boton Variante="VarianteBoton.Destructivo" Cargando="_procesandoBajaLote" OnClick="ConfirmarBajaLoteAsync">
            Dar de baja
        </Boton>
    </Pie>
</Modal>

<DrawerGestionDocumento @ref="_drawerGestion" OnGuardado="ManejarDocumentoGuardadoAsync" />
<DrawerAsignacionMasiva @ref="_drawerAsignacion" OnGuardado="ManejarAsignacionGuardadaAsync" />
