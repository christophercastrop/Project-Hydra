<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="FluentAssertions" Version="6.*" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sin copiarlo a la salida el runner nunca lo lee, y el paralelismo
         sigue siendo el de por defecto (un hilo por núcleo) — que es lo que
         agotaba las conexiones de PostgreSQL, ver BaseDatosPostgresDePruebas. -->
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />

    <!-- La especificación normativa de los roles de clúster vive fuera del
         ensamblado de migraciones a propósito: allí el ratchet prohíbe crear
         roles sin excepciones. El arnés la ejecuta como adaptador, sin
         redefinir ni un atributo (ver BootstrapDeClusterEnTests). -->
    <None Include="../../deploy/bootstrap/roles-de-cluster.sql"
          Link="roles-de-cluster.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CaeManager.Infrastructure\CaeManager.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\CaeManager.Migrations.PostgreSQL\CaeManager.Migrations.PostgreSQL.csproj" />
    <ProjectReference Include="..\..\src\CaeManager.Application\CaeManager.Application.csproj" />
    <ProjectReference Include="..\..\src\CaeManager.Domain\CaeManager.Domain.csproj" />
    <ProjectReference Include="..\..\src\CaeManager.Web\CaeManager.Web.csproj" />
  </ItemGroup>

</Project>